{
  "name": "@wieslawsoltes/counterform-font-io",
  "version": "0.7.0",
  "type": "module",
  "description": "TrueType/CFF OpenType compilation, WOFF containers and bounded font import.",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./types/index.d.ts",
  "dependencies": {
    "@wieslawsoltes/counterform-binary": "0.7.0",
    "@wieslawsoltes/counterform-model": "0.7.0",
    "@wieslawsoltes/counterform-geometry": "0.7.0",
    "@wieslawsoltes/counterform-opentype": "0.7.0",
    "@wieslawsoltes/counterform-color": "0.7.0"
  },
  "keywords": [
    "font-editor",
    "opentype",
    "type-design",
    "webgpu",
    "counterform"
  ]
