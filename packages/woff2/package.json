    }
  },
  "files": [
    "src",
    "types",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@wieslawsoltes/counterform-binary": "0.5.0"
  }
}
