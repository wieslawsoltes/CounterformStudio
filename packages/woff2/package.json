{
  "name": "@wieslawsoltes/counterform-woff2",
  "version": "0.5.0",
  "description": "Portable WOFF2 container encoding",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
